# Bu dosya yalnızca değişken ADLARINI gösterir. Gerçek değerleri buraya yazmayın;
# Vercel > Project > Settings > Environment Variables ekranına girin.

# Supabase > Project Settings > Data API / API Keys
SUPABASE_URL=
# Tarayıcıya gönderilmesi güvenli olan anahtar (sb_publishable_... veya anon)
SUPABASE_PUBLISHABLE_KEY=
# GİZLİ: yalnızca sunucu fonksiyonları kullanır (sb_secret_... veya service_role). "Sensitive" işaretleyin.
SUPABASE_SECRET_KEY=

# GİZLİ: Vercel Cron isteklerini doğrulamak için rastgele uzun bir değer. "Sensitive" işaretleyin.
CRON_SECRET=
