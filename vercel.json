{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": ["dub1"],
  "functions": {
    "api/portal.js": { "includeFiles": "portal-pages/**" }
  },
  "crons": [
    { "path": "/api/cron/daily", "schedule": "0 0 * * *" }
  ],
  "redirects": [
    { "source": "/ikna", "destination": "/ikna/", "permanent": false },
    { "source": "/benim-molam", "destination": "/gunluk-verilerim/", "permanent": true },
    { "source": "/benim-molam/:path*", "destination": "/gunluk-verilerim/", "permanent": true },
    { "source": "/kpi/yonetici", "destination": "/admin/kpi/", "permanent": true },
    { "source": "/kpi/yonetici/:path*", "destination": "/admin/kpi/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/api/portal?r=page/home" },
    { "source": "/ikna/", "destination": "/api/portal?r=page/ikna" },
    { "source": "/api/daily/:path*", "destination": "/api/portal?r=daily/:path*" },
    { "source": "/api/admin/:path*", "destination": "/api/portal?r=admin/:path*" },
    { "source": "/api/state", "destination": "/api/portal?r=state" },
    { "source": "/api/weather/elazig", "destination": "/api/portal?r=weather" },
    { "source": "/api/kpi/:path*", "destination": "/api/portal?r=kpi/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    },
    {
      "source": "/(giris|uzman|yonetici)(.html)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/admin/kpi/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; img-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; style-src 'self' 'unsafe-inline'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
